# Copy to .env. Never commit .env. Never put real secrets in this file.
# Real values belong only in the untracked .env (local) or in Space Secrets (deployed).
# Process environment variables override values in .env. Run commands from the repo root.

# --- App ---------------------------------------------------------------------
# Where the app runs: local | ci | space. REQUIRED. A deployed Space must use "space".
KHETSETU_APP_ENV=local
# Logging verbosity: DEBUG | INFO | WARNING | ERROR. Default: INFO.
KHETSETU_LOG_LEVEL=INFO

# --- Server ------------------------------------------------------------------
# Interface the web server binds to. Optional; unset lets the server choose its default.
# KHETSETU_SERVER_HOST=127.0.0.1
# Port the web server listens on, 1-65535. Optional; unset lets the server choose.
# KHETSETU_SERVER_PORT=7860

# --- Upload limits -----------------------------------------------------------
# Largest accepted upload in bytes, 1-52428800. Default: 10485760 (10 MiB).
KHETSETU_MAX_UPLOAD_BYTES=10485760
# Largest accepted image in pixels (width x height), 1-200000000. Default: 40000000.
KHETSETU_MAX_IMAGE_PIXELS=40000000

# --- Dataset -----------------------------------------------------------------
# Directory holding the downloaded training dataset (git-ignored). Default: data
KHETSETU_DATA_DIR=data
# Hugging Face dataset repository, owner/name. Default: Project-AgML/plant_village_classification
KHETSETU_DATASET_REPO_ID=Project-AgML/plant_village_classification
# Pinned dataset revision: a 40-character commit sha or a ref name. Default: the pinned sha.
KHETSETU_DATASET_REVISION=cb08789a92460034ced0449eac1dba72bb4883da
# Whether tools may download the dataset: blocking | off. Optional.
# Default when unset: blocking for local, off for ci and space. A Space rejects "blocking".
# KHETSETU_DATASET_MODE=off

# --- Hugging Face ------------------------------------------------------------
# Access token (SECRET). Optional until features that call Hugging Face need it.
# Leave blank here. On a Space, store it as a Secret, never as a Variable.
HF_TOKEN=
# This Space's id, owner/name. Optional; Hugging Face also sets SPACE_ID inside a Space.
# HF_SPACE_ID=your-username/khetsetu

# --- LLM ---------------------------------------------------------------------
# Chat model id served by Hugging Face Inference Providers. Default: google/gemma-4-26B-A4B-it
KHETSETU_LLM_MODEL=google/gemma-4-26B-A4B-it
